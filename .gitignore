*.xyz
build/
dist/
pyncraft.egg-info
build.txt
*.pyc
__pycache__/

# 3D models for the STL examples.
#
# These are tens of megabytes each and git stores every version of them for
# ever, so the repository already carries ~67 MB of them and a clone pays for
# it. Keep new ones out.
#
# NOTE: this does not untrack the ones already committed -- gitignore only
# applies to untracked files. Those need somewhere to live first (a release
# asset, or a small fetch script beside the examples) because trex.py and
# render_stl.py genuinely need them.
examples/data/*.stl
examples/data/*.STL

# other large binaries that have no business in a source repository
*.jar
*.zip

# Cached Exoplanet Archive queries. Two kilobytes each and answered in a
# second, so caching them in git would only serve stale numbers -- the whole
# point is that the archive is live.
examples/data/exo*.csv

# Where a build of a planetary system put its blocks, so the next build can
# clear them. Specific to one world and one set of coordinates; useless in a
# clone and actively wrong if it travelled to another server.
examples/data/exo_build_*.json
